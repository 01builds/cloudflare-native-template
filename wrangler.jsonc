{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-gateway",
  "main": "packages/gateway/src/index.ts",
  "compatibility_date": "2024-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE_R2",
      "bucket_name": "app-storage"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "env": {
    "development": {
      "name": "app-gateway-dev",
      "vars": {
        "ENVIRONMENT": "development"
      }
    },
    "staging": {
      "name": "app-gateway-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "app-db-staging",
          "database_id": "11111111-1111-1111-1111-111111111111"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE_KV",
          "id": "11111111111111111111111111111111"
        }
      ]
    }
  }
}
